# KLeanScreen on the printer's display. Install (fills in the user and home):
#   sed -e "s|@USER@|$USER|g" -e "s|@HOME@|$HOME|g" system/KLeanScreen.service \
#     | sudo tee /etc/systemd/system/KLeanScreen.service >/dev/null
# Stop any other screen first (KlipperScreen, a desktop): both want tty7 and the display.
# PAMName and TTYPath give cage a logind seat session, which it needs to open
# the DRM device and the touchscreen.
[Unit]
Description=KLeanScreen
StartLimitIntervalSec=0
After=moonraker.service systemd-user-sessions.service plymouth-quit-wait.service dbus.socket systemd-logind.service
Wants=dbus.socket systemd-logind.service
ConditionPathExists=/dev/tty0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/KLeanScreen
ExecStart=@HOME@/KLeanScreen/scripts/kleanscreen-start.sh
Restart=always
RestartSec=2
UtmpIdentifier=tty7
UtmpMode=user
PAMName=%u
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
