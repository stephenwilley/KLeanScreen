#!/usr/bin/env bash
set -u

for attempt in $(seq 1 30); do
    if modprobe hdmi_clock_fix target_rate=37125000; then
        exit 0
    fi
    echo "hdmi-clock-fix: load attempt $attempt failed; retrying" >&2
    sleep 1
done

echo "hdmi-clock-fix: HDMI clock recovery failed after 30 attempts" >&2
exit 1
